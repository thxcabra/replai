# Modo "team" do Vite: usado pelo script `npm run build:team`.
# Sobrepoe apenas Gemini e Anthropic com strings vazias. A VITE_TWITTERAPI_KEY
# nao e sobreposta, entao ela permanece com o valor do .env (que voce mantem
# por fora do git). Resultado: build com TwitterAPI compartilhada do time
# embutida, sem expor suas chaves de LLM pessoais.

VITE_GEMINI_API_KEY=
VITE_ANTHROPIC_API_KEY=
