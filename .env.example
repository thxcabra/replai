# Copie para .env e preencha. O .env real fica fora do git.
# As chaves aqui sao FALLBACK: se preencher a chave na UI de settings, ela tem prioridade.

# TwitterAPI.io: necessaria pra puxar tweets da Lista.
# https://twitterapi.io
VITE_TWITTERAPI_KEY=

# Gemini (provider default, free tier).
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Anthropic (provider opcional, pago). So preencha se for trocar pra Claude na UI.
# https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=

# (opcional) Base alternativa da TwitterAPI; usada no preview pra contornar CORS.
# VITE_TWITTERAPI_BASE=
