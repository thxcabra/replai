{
  "name": "replai-extension",
  "version": "0.5.3",
  "description": "Triagem semantica de tweets de Listas do X com geracao de replies via LLM, voz por workspace, sync cross-device e analytics admin.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsc --noEmit && npm run check:manual-csv && npm run check:email-domain",
    "build:cws:win": "set REPLAI_CWS_BUILD=1&& tsc --noEmit && set REPLAI_CWS_BUILD=1&& vite build",
    "build:cws:unix": "REPLAI_CWS_BUILD=1 tsc --noEmit && REPLAI_CWS_BUILD=1 vite build",
    "check:manual-csv": "node --experimental-strip-types scripts/check-manual-list-csv.mjs",
    "check:email-domain": "node --experimental-strip-types scripts/check-email-domain.mjs",
    "preview": "vite preview",
    "preview:ui": "vite --config vite.preview.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "pdfjs-dist": "^6.0.227",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@preact/preset-vite": "^2.10.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/chrome": "^0.0.299",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
