{
  "name": "replai-extension",
  "version": "0.1.0",
  "description": "Replai - triagem semantica e sugestoes de reply pra tweets de POIs (POC)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:team": "tsc --noEmit && vite build --mode team --outDir release --emptyOutDir",
    "build:public": "tsc --noEmit && vite build --mode public --outDir release --emptyOutDir",
    "preview": "vite preview",
    "preview:ui": "vite --config vite.preview.config.ts"
  },
  "dependencies": {
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@preact/preset-vite": "^2.10.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/chrome": "^0.0.299",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
